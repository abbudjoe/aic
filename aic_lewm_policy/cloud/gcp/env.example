# Copy this file to .env and edit if needed.

GCP_PROJECT=project-81f2add4-9e80-4335-bb6
GCP_REGION=us-west4
GCP_ZONE=us-west4-a
GCP_INSTANCE=aic-lewm-l4
GCP_MACHINE_TYPE=g2-standard-16
GCP_BOOT_DISK_SIZE=300GB
GCP_BOOT_DISK_TYPE=pd-balanced

# Existing bucket observed in this project. Replace with a dedicated bucket if
# you prefer keeping AIC artifacts separate.
GCP_BUCKET=gs://fractal-maxtext-runs-81f2add4
GCP_PREFIX=aic-lewm

LEWM_LOCAL_ROOT=/Users/joseph/le-wm

# Set this once an AIC rollout dataset exists.
# AIC_DATASET_LOCAL=/absolute/path/to/aic_qualification_train.h5
AIC_DATASET_NAME=aic_qualification_train

LEWM_RUN_NAME=aic-lewm-baseline
LEWM_MAX_EPOCHS=100
LEWM_BATCH_SIZE=64

# Optional: separate empirical run id for manifest/ledger records. Defaults to
# LEWM_RUN_NAME when unset.
# AIC_EXPERIMENT_RUN_ID=aic-lewm-baseline

# Optional: data collection image/run knobs for run_recording.sh.
# AIC_RECORDING_IMAGE=aic-lewm-recording:aic-lewm-baseline
# AIC_LEWM_RECORD_HZ=20
# AIC_LEWM_RECORD_IMAGE_SCALE=0.25

# Optional: Python executable used by upload_dataset.sh for HDF5 validation.
# Defaults to the repo Pixi environment when it exists, then python3.
# AIC_LEWM_HARNESS_PYTHON=/absolute/path/to/python
